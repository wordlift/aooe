<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:dct="http://purl.org/dc/terms/"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:aooe="https://w3id.org/aooe#"
>
  <owl:ObjectProperty rdf:about="https://w3id.org/aooe#providesLevel">
    <rdfs:label xml:lang="en">provides level</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/aooe#AdoptionLevel"/>
    <skos:definition xml:lang="en">The highest adoption level a package (an ontology module, bundle or brand layer) ships and proves. The gate runner refuses a declared level the package does not pass.</skos:definition>
    <skos:scopeNote xml:lang="en">Optional in v0.7 (absent is reported as undeclared); required from v0.8.</skos:scopeNote>
  </owl:ObjectProperty>
  <rdf:Property rdf:about="https://w3id.org/aooe#termsReused">
    <rdfs:label xml:lang="en">terms reused</rdfs:label>
    <skos:definition xml:lang="en">The external terms a bundle actually wires into its ontology body. A term listed here but never used is manifest drift (gate C4).</skos:definition>
    <skos:scopeNote xml:lang="en">Carried as a comma-separated CURIE string (v0.3 convention) or as repeated IRIs (v0.6 convention).</skos:scopeNote>
  </rdf:Property>
  <owl:ObjectProperty rdf:about="https://w3id.org/aooe#includesLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">includes level</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/aooe#AdoptionLevel"/>
    <rdfs:range rdf:resource="https://w3id.org/aooe#AdoptionLevel"/>
    <skos:definition xml:lang="en">The lower level a level contains. Levels are cumulative: claiming a level claims every level it includes.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/aooe#reuseMode">
    <rdfs:label xml:lang="en">reuse mode</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">identity: the term and IRI are reused and property characteristics are added locally; axioms: the source axiomatization is adopted as well.</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/aooe#importedVocabulary">
    <rdfs:label xml:lang="en">imported vocabulary</rdfs:label>
    <skos:definition xml:lang="en">Links a manifest annotation block to the vocabulary it pins.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/aooe#adopter">
    <rdfs:label xml:lang="en">adopter</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/aooe#AdoptionRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The team, system or organisation unit that adopts.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/aooe#adoptedRelease">
    <rdfs:label xml:lang="en">adopted release</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/aooe#AdoptionRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The release tag of the bundle the adopter pins (for example core/v0.2.0).</skos:definition>
  </owl:DatatypeProperty>
  <aooe:AdoptionLevel rdf:about="https://w3id.org/aooe#Rulebook">
    <rdfs:label xml:lang="en">Rulebook</rdfs:label>
    <aooe:includesLevel>
      <aooe:AdoptionLevel rdf:about="https://w3id.org/aooe#Map">
        <rdfs:label xml:lang="en">Map</rdfs:label>
        <aooe:includesLevel rdf:resource="https://w3id.org/aooe#Legend"/>
        <skos:definition xml:lang="en">The data model: classes, properties, application profiles, qualified relations and locally added property characteristics. Done when Legend is done, every term carries a label and a definition, reused external terms are wired, no external property carries a local domain or range, the module is reasoner-consistent, and at least one positive example uses the term with only declared terms.</skos:definition>
        <skos:scopeNote xml:lang="en">Grants readability and analysis. A Map-level consumer can load and query the data. It cannot let an agent act on it.</skos:scopeNote>
      </aooe:AdoptionLevel>
    </aooe:includesLevel>
    <skos:definition xml:lang="en">Validation and behavior: SHACL shapes, negative examples, Behavioral Concept Specifications, policy envelopes, gates, eval items and reward specs. Done when Map is done and the full definition of done holds: shapes target the class, positives conform, negatives fail independently, the non-vacuity sentinel passes, the BCS has eleven sections, the envelope is signed, and eval and reward execute.</skos:definition>
    <skos:scopeNote xml:lang="en">Grants agency. Only data governed at Rulebook level may be acted on by an agent (Core Rule 8). The Lab-private compilation layer (rewards, traces, benchmarks, curriculum releases) is the top of the Rulebook, not a fourth level.</skos:scopeNote>
  </aooe:AdoptionLevel>
  <owl:DatatypeProperty rdf:about="https://w3id.org/aooe#adoptedSince">
    <rdfs:label xml:lang="en">adopted since</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/aooe#AdoptionRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="https://w3id.org/aooe#">
    <rdfs:label xml:lang="en">AOOE — Agent-Oriented Ontology Engineering vocabulary</rdfs:label>
    <dct:description xml:lang="en">Terms the AOOE methodology uses to annotate import manifests, Behavioral Concept Specifications and adoption levels. This is a methodology vocabulary, not a domain vocabulary: it never appears in a public projection.</dct:description>
    <owl:versionInfo>0.7.0</owl:versionInfo>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dct:created>
    <dct:publisher rdf:resource="https://wordlift.io/"/>
  </owl:Ontology>
  <owl:ObjectProperty rdf:about="https://w3id.org/aooe#governs">
    <rdfs:label xml:lang="en">governs</rdfs:label>
    <skos:definition xml:lang="en">Links a BCS to the behavioral class whose instances it governs.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/aooe#adoptsLevel">
    <rdfs:label xml:lang="en">adopts level</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/aooe#AdoptionRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/aooe#AdoptionLevel"/>
    <skos:definition xml:lang="en">The level a consumer claims for one use case.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/aooe#refines">
    <rdfs:label xml:lang="en">refines</rdfs:label>
    <skos:definition xml:lang="en">Links a refinement BCS to its parent; definition of done is parent plus delta, and the delta may only tighten.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/aooe#servesACQ">
    <rdfs:label xml:lang="en">serves agent competency question</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The competency question(s) that justify an import.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/aooe#governanceNote">
    <rdfs:label xml:lang="en">governance note</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/aooe#useCase">
    <rdfs:label xml:lang="en">use case</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/aooe#AdoptionRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/aooe#pinnedVersion">
    <rdfs:label xml:lang="en">pinned version</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The verified version of an imported vocabulary, stated on the vocabulary IRI (v0.6 convention). The v0.3 convention states owl:versionInfo on the annotation block instead; both are accepted.</skos:definition>
    <skos:scopeNote xml:lang="en"><![CDATA[A pin is verified, never asserted. An unverifiable pin is written UNVERIFIED-<date> and reported.]]></skos:scopeNote>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/aooe#AdoptionLevel">
    <rdfs:label xml:lang="en">Adoption level</rdfs:label>
    <skos:definition xml:lang="en">A cumulative conformance level of the AOOE methodology. Each level has its own definition of done and its own gate subset.</skos:definition>
  </owl:Class>
  <aooe:AdoptionLevel rdf:about="https://w3id.org/aooe#Legend">
    <rdfs:label xml:lang="en">Legend</rdfs:label>
    <skos:definition xml:lang="en">The vocabulary reference: which external vocabularies are reused, at which verified versions, under which prefixes, and how instance identifiers are minted. Done when every import is pinned and verified, every prefix binds to one IRI, pins live only in the import manifest, and the identity policy is written.</skos:definition>
    <skos:scopeNote xml:lang="en">Grants addressability. A Legend-level consumer can read and name the data. It cannot claim the data model or any validation.</skos:scopeNote>
  </aooe:AdoptionLevel>
  <owl:Class rdf:about="https://w3id.org/aooe#AdoptionRecord">
    <rdfs:label xml:lang="en">Adoption record</rdfs:label>
    <skos:definition xml:lang="en">One row of a bundle's adoption register: who adopts, for which use case, at which level, since when, pinned to which release.</skos:definition>
  </owl:Class>
</rdf:RDF>
